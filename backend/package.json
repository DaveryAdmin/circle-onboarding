{
  "name": "circle-onboarding-api",
  "version": "1.0.0",
  "description": "Circle Onboarding System — Express API",
  "main": "src/server.js",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('./src/models/db').migrate.latest({ directory: './src/models/migrations' }).then(() => { console.log('done'); process.exit(0); }).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  }
}